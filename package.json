{
  "name": "blastradius",
  "version": "1.1.0",
  "description": "Explainable pull-request impact analysis for engineering teams.",
  "private": true,
  "bin": {
    "blastradius": "dist/cli/src/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:cli": "tsc -p packages/cli/tsconfig.json",
    "cli": "npm run build:cli && node dist/cli/src/index.js",
    "fixtures:update": "npm run build:cli && node scripts/update-golden.mjs",
    "fixtures:refresh": "npm run build:cli && node scripts/refresh-golden.mjs",
    "evaluate": "npm run build:cli && node scripts/evaluate.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build:cli && npm run build"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.8",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4"
  },
  "type": "module"
}
